{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/projects/:path*",
            "destination": "https://my-portfolio-mu-sooty-32.vercel.app/projects/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/app.html"
        }
    ]
}
